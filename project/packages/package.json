{
  "name": "vault-files",
  "version": "0.1.0-alpha",
  "description": "The ultimate file conversion & document management ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vf": "dist/cli/bin/vf.js",
    "vault-files": "dist/cli/bin/vf.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch project/src/index.ts",
    "dev:cli": "tsx project/cli/bin/vf.ts",
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "build:cli": "npm run build && chmod +x dist/cli/bin/vf.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:converters": "jest --testPathPattern=converters",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage .tsbuildinfo"
  },
  "keywords": [
    "pdf",
    "document",
    "conversion",
    "markdown",
    "docx",
    "pptx",
    "file-management",
    "ocr",
    "document-processing"
  ],
  "author": "PtiCalin (Charlie)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PtiCalin/vault-files.git"
  },
  "bugs": {
    "url": "https://github.com/PtiCalin/vault-files/issues"
  },
  "homepage": "https://github.com/PtiCalin/vault-files#readme",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "pdf-parse": "^1.1.1",
    "marked": "^12.0.2",
    "docx": "^8.5.0",
    "mammoth": "^1.7.2",
    "pptxgenjs": "^3.12.0",
    "puppeteer": "^22.0.0",
    "commander": "^12.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "glob": "^10.3.12",
    "sharp": "^0.33.3",
    "tesseract.js": "^5.0.5",
    "jszip": "^3.10.1",
    "mime-types": "^2.1.35",
    "file-type": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/mime-types": "^2.1.4",
    "@types/glob": "^8.1.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/puppeteer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
